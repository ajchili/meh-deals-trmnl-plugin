<div class="layout grid">
  <div class="col">
    <div class="grid" style="height: 60%">
      {% for photo in photos | limit:3 %}
        <img class="image-dither" src="{{ photo }}" width="100%" height="100%" style="object-fit: contain;">
      {% endfor %}
    </div>
    <span class="label">{{ price }}</span>
    {% for feature in features %}
    <div class="item" style="margin-bottom: 4px;">
      <div class="meta"></div>
      <div class="content">
        <span class="description clamp--2">{{ feature }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
</div>