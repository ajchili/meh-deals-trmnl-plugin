<div class="layout grid">
  <div class="col">
    <img class="image-dither" src="{{ photos[0] }}" width="100%" height="50%" style="object-fit: contain;">
    <span class="label">{{ price }}</span>
    {% for feature in features %}
    <div class="item" style="margin-bottom: 4px;">
      <div class="meta"></div>
      <div class="content">
        <span class="description clamp--3">{{ feature }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
</div>